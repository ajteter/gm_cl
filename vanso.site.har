          "content": {
            "size": 3040,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n   <title>Floppy Bird</title>\n   <meta http-equiv=\"content-type\" content=\"text/html; charset=utf-8\" />\n   <meta name=\"author\" content=\"Nebez Briefkani\" />\n   <meta name=\"description\" content=\"play floppy bird. a remake of popular game flappy bird built in html/css/js\" />\n   <meta name=\"keywords\"\n      content=\"flappybird,flappy,bird,floppybird,floppy,html,html5,css,css3,js,javascript,jquery,github,nebez,briefkani,nebezb,open,source,opensource\" />\n   <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0\" />\n\n   <!-- Open Graph tags -->\n   <meta property=\"og:title\" content=\"Floppy Bird\" />\n   <meta property=\"og:description\"\n      content=\"play floppy bird. a remake of popular game flappy bird built in html/css/js\" />\n   <meta property=\"og:type\" content=\"website\" />\n   <meta property=\"og:image\" content=\"https://nebezb.com/floppybird/assets/thumb.png\" />\n   <meta property=\"og:url\" content=\"https://nebezb.com/floppybird/\" />\n   <meta property=\"og:site_name\" content=\"Floppy Bird\" />\n\n   <!-- Style sheets -->\n   <link href=\"css/reset.css\" rel=\"stylesheet\">\n   <link href=\"css/main.css\" rel=\"stylesheet\">\n\n   <script defer src=\"https://yummy.nebez.dev/script.js\"\n      data-website-id=\"9ceaba15-371f-4407-a59a-f57a7214af41\"></script>\n</head>\n\n<body>\n   <div id=\"gamecontainer\">\n      <div id=\"gamescreen\">\n         <div id=\"sky\" class=\"animated\">\n            <div id=\"flyarea\">\n               <div id=\"ceiling\" class=\"animated\"></div>\n               <!-- This is the flying and pipe area container -->\n               <div id=\"player\" class=\"bird animated\"></div>\n\n               <div id=\"bigscore\"></div>\n\n               <div id=\"splash\"></div>\n\n               <div id=\"scoreboard\">\n                  <div id=\"medal\"></div>\n                  <div id=\"currentscore\"></div>\n                  <div id=\"highscore\"></div>\n                  <div id=\"replay\"><img src=\"assets/replay.png\" alt=\"replay\"></div>\n               </div>\n\n               <!-- Pipes go here! -->\n            </div>\n         </div>\n         <div id=\"land\" class=\"animated\">\n            <div id=\"debug\"></div>\n         </div>\n      </div>\n   </div>\n   <div id=\"footer\">\n   </div>\n   <div class=\"boundingbox\" id=\"playerbox\"></div>\n   <div class=\"boundingbox\" id=\"pipebox\"></div>\n\n   <script src=\"js/jquery.min.js\"></script>\n   <script src=\"js/jquery.transit.min.js\"></script>\n   <script src=\"js/buzz.min.js\"></script>\n   <script src=\"js/main.js\"></script>\n<script defer src=\"https://static.cloudflareinsights.com/beacon.min.js/v8c78df7c7c0f484497ecbca7046644da1771523124516\" integrity=\"sha512-8DS7rgIrAmghBFwoOTujcf6D9rXvH8xm8JQ1Ja01h9QX8EzXldiszufYa4IFfKdLUKTTrnSFXLDkUEOTrZQ8Qg==\" data-cf-beacon='{\"version\":\"2024.11.0\",\"token\":\"77e6138518c8456885ed31d25e3a99d3\",\"r\":1,\"server_timing\":{\"name\":{\"cfCacheStatus\":true,\"cfEdge\":true,\"cfExtPri\":true,\"cfL4\":true,\"cfOrigin\":true,\"cfSpeedBrain\":true},\"location_startswith\":null}}' crossorigin=\"anonymous\"></script>\n</body>\n\n</html>"
          },
